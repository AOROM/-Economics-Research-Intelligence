{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Economics Research Radar monitor",
  "type": "object",
  "required": ["monitor_id", "topic", "chinese_monitor"],
  "properties": {
    "monitor_id": {"type": "string", "minLength": 1},
    "timezone": {"type": "string"},
    "topic": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "include_concepts": {"type": "array", "items": {"type": "string"}},
        "preferred_methods": {"type": "array", "items": {"type": "string"}},
        "preferred_datasets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "chinese_monitor": {
      "type": "object",
      "required": ["official_site_only", "auto_expand_journals", "allow_database_discovery", "journals"],
      "properties": {
        "official_site_only": {"const": true},
        "auto_expand_journals": {"const": false},
        "allow_database_discovery": {"const": false},
        "journals": {"type": "array", "items": {"$ref": "#/$defs/chinese_journal"}}
      }
    },
    "international_monitor": {
      "type": "object",
      "properties": {
        "sources": {"type": "array", "items": {"$ref": "#/$defs/international_source"}}
      }
    }
  },
  "$defs": {
    "chinese_journal": {
      "type": "object",
      "required": ["name", "homepage"],
      "properties": {
        "name": {"type": "string"},
        "homepage": {"type": "string", "format": "uri"},
        "allowed_hosts": {"type": "array", "items": {"type": "string"}},
        "priority": {"enum": ["normal", "critical"]},
        "status": {"enum": ["active", "pending", "blocked"]},
        "adapter": {"enum": ["html", "ajcass_api", "pku_issue"]},
        "allow_http": {"type": "boolean"},
        "api_url": {"type": "string", "format": "uri"},
        "journal_id": {"type": ["integer", "string"]},
        "detail_url_template": {"type": "string"},
        "detail_uses_issue_context": {"type": "boolean"},
        "fetch_details": {"type": "boolean"},
        "issue_index_url": {"type": "string", "format": "uri"},
        "issue_link_regex": {"type": "string"},
        "issue_title_regex": {"type": "string"},
        "label": {"type": "string"},
        "note": {"type": "string"},
        "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["pending", "blocked"]}}, "required": ["status"]},
          "then": {"properties": {"surfaces": {"maxItems": 0}}}
        }
      ]
    },
    "surface": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "item_selector": {"type": "string"},
        "title_selector": {"type": "string"},
        "link_selector": {"type": "string"},
        "link_path_regex": {"type": "string"},
        "article_metadata": {"type": "boolean"},
        "article_metadata_required": {"type": "boolean"},
        "author_selector": {"type": "string"},
        "abstract_selector": {"type": "string"},
        "abstract_attribute": {"type": "string"},
        "title_strip_regex": {"type": "string"},
        "minimum_title_length": {"type": "integer", "minimum": 1},
        "date_selector": {"type": "string"},
        "next_selector": {"type": "string"},
        "max_pages": {"type": "integer", "minimum": 1},
        "article": {"type": "object"}
      },
      "anyOf": [
        {"required": ["link_path_regex"]},
        {"required": ["item_selector", "title_selector", "link_selector"]}
      ]
    },
    "international_source": {
      "type": "object",
      "required": ["provider", "name", "feed_url"],
      "properties": {
        "provider": {"enum": ["nber", "cepr", "repec", "ssrn", "journal"]},
        "name": {"type": "string"},
        "feed_url": {"type": "string", "format": "uri"},
        "priority": {"enum": ["normal", "critical"]}
      }
    }
  }
}
